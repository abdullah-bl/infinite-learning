# Backend secrets. Copy to .env.local for `bun run dev:api`; on Fly use `fly secrets set`.
# Free key at https://openrouter.ai/keys (free models need no credit, but are rate limited).
OPENROUTER_API_KEY=
# Optional: up to three model ids, tried in order. Default: openrouter/free and two fallbacks.
# OPENROUTER_MODELS=openrouter/free,google/gemma-4-31b-it:free
# Optional: point at another OpenAI-compatible endpoint (the tests use a mock).
# OPENROUTER_URL=https://openrouter.ai/api/v1
